{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=MicRiskDev;Integrated Security=True;TrustServerCertificate=True;Encrypt=False;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JWT": {
    "Issuer": "http://localhost:5166",
    "Audience": "http://localhost:5166",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 60,
    "RefreshTokenAbsoluteDays": 0,
    "RefreshTokenReuseLeewaySeconds": 30,
    "RefreshCookieName": "mic_refresh_token",
    "RefreshCookiePath": "/api/account",
    "RefreshCookieSameSite": "Strict"
  },
  "Cors": {
    "AllowedOrigins": ["*"]
  },
  "FileUpload": {
    "MaxFileSizeBytes": 10485760,
    "UploadSubdirectory": "uploads"
  }
}
