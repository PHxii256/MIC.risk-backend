<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cfde08d7-dc8f-4b8e-99d3-166ce3f8e00d</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.17" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Uploaded files are runtime data that happens to live under wwwroot so static file serving
      can reach it. They must be removed from the project's item set entirely, not merely marked
      not-to-watch: the Web SDK globs wwwroot into Content, so a file appearing at runtime adds a
      new project item, and dotnet watch's hot-reload workspace crashes re-evaluating it
      ("Unexpected true - HotReloadMSBuildWorkspace.cs"). Remove takes them out of the item list
      altogether, which also keeps them out of publish output where they do not belong.
    -->
    <Content Remove="wwwroot/uploads/**" />
    <None Remove="wwwroot/uploads/**" />
    <Watch Remove="wwwroot/**" />
  </ItemGroup>
</Project>